generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id               String   @id @default(uuid())
  caseId           String   @unique
  encryptedContent String   // AES-256 encrypted payload
  iv               String   // Initialization Vector (hex)
  authTag          String   // GCM Auth Tag (hex)
  internalStatus   String   @default("RECEIVED") // HR Internal state
  publicStatus     String   @default("Received") // One of 4 public states: Received, In Review, Update Available, Closed
  
  // Problem 5: Encrypted Official Status Note / Directive for Complainant
  statusNoteEncrypted String? // AES-256 encrypted status note
  statusNoteIv        String? // Initialization Vector (hex)
  statusNoteAuthTag   String? // GCM Auth Tag (hex)
  statusNoteUpdatedAt DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  statusUpdates    StatusUpdateQueue[]
  messages         CaseMessage[]
}

model StatusUpdateQueue {
  id                 String   @id @default(uuid())
  caseId             String
  targetStatus       String
  targetNoteEncrypted String? // Optional encrypted note queued for batched release
  targetNoteIv        String?
  targetNoteAuthTag   String?
  scheduledReleaseAt DateTime
  released           Boolean  @default(false)
  createdAt          DateTime @default(now())

  case               Case     @relation(fields: [caseId], references: [caseId], onDelete: Cascade)
}

model CaseMessage {
  id               String   @id @default(uuid())
  caseId           String
  sender           String   // 'COMPLAINANT' or 'ICC'
  encryptedContent String   // AES-256 encrypted message payload
  iv               String   // Hex IV
  authTag          String   // GCM Auth Tag (hex)
  createdAt        DateTime @default(now())

  case             Case     @relation(fields: [caseId], references: [caseId], onDelete: Cascade)
}
